# Strapi CMS (see docs/CMS.md). Without these the site builds with EMPTY
# content — fine for tooling, wrong for a real build/deploy.
STRAPI_API_URL=https://your-strapi-host
# Read-only API token (Settings → API Tokens, custom: find/findOne on
# Article, Case study, Experiment)
STRAPI_API_TOKEN=

# Only for the one-time seed script (full-access token):
# STRAPI_SEED_TOKEN=
