        640
      ],
      "parameters": {
        "jsCode": "const results = $input.all().map((i) => i.json);\nconst a = $('Normalize Published Article').first().json;\nconst labels = { linkedin: 'LinkedIn', x: 'X', telegram: 'Telegram channel', site: 'Site rebuild' };\nconst icons = { posted: '✅', triggered: '✅', skipped: '⏭️', failed: '❌' };\nconst esc = (v) => String(v ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');\nconst by = new Map(results.filter((r) => r.platform).map((r) => [r.platform, r]));\nconst lines = ['<b>Syndication complete</b>', '', '<b>' + esc(a.title) + '</b>', esc(a.url), ''];\nfor (const p of ['linkedin', 'x', 'telegram', 'site']) {\n  const r = by.get(p) || { status: 'failed', error: 'No result received' };\n  const detail = r.url ? ' - ' + esc(r.url) : r.reason ? ' - ' + esc(r.reason) : r.error ? ' - ' + esc(r.error) : '';\n  lines.push((icons[r.status] || 'ℹ️') + ' <b>' + labels[p] + ':</b> ' + esc(r.status) + detail);\n}\nlines.push('', 'Publishing switches live in PublishFlags.');\nreturn [{ json: { message: lines.join('\\n') } }];"
      }
