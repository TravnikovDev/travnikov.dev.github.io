    {
      "id": "normalize",
      "name": "Normalize Article",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        520
      ],
      "parameters": {
        "jsCode": "const raw = String($input.first().json.output ?? '').trim();\nconst research = $('Research Agent (Perplexity)').first().json;\nconst brief = String($('Brief Agent').first().json.output ?? $('MainData').first().json.mainPrompt ?? '').trim();\n\nlet parsed;\ntry {\n  const unfenced = raw.replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim();\n  const start = unfenced.indexOf('{');\n  const end = unfenced.lastIndexOf('}');\n  parsed = JSON.parse(start >= 0 && end > start ? unfenced.slice(start, end + 1) : unfenced);\n} catch {\n  parsed = { body: raw };\n}\n\nconst clean = (v) => String(v ?? '').replace(/\\s+/g, ' ').trim();\nconst slugify = (v) => clean(v).toLowerCase().normalize('NFKD')\n  .replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '').slice(0, 90);\n\nconst body = String(parsed.body ?? raw).trim();\nconst title = clean(parsed.title || clean(brief).slice(0, 90) || 'Untitled article');\nconst slug = slugify(parsed.slug || title) || 'article-' + $now.toFormat('yyyy-MM-dd-HHmm');\nconst plain = clean(body.replace(/[#*_>\\[\\]()]/g, ''));\nconst excerpt = clean(parsed.excerpt || plain.slice(0, 240));\n\nconst tags = (Array.isArray(parsed.tags) ? parsed.tags : [])\n  .map((t) => clean(t).toLowerCase()).filter(Boolean).slice(0, 5);\n\nconst citations = [...new Set([\n  ...(Array.isArray(parsed.citations) ? parsed.citations : []),\n  ...(Array.isArray(research.citations) ? research.citations : []),\n].filter((v) => typeof v === 'string' && /^https?:\\/\\//i.test(v)))];\n\n// fail loudly rather than writing a stub into the CMS\nif (!title || body.length < 300) {\n  throw new Error('Article validation failed: empty title or body under 300 characters.');\n}\n\nreturn [{ json: {\n  title, slug, excerpt, body, tags, citations,\n  seoTitle: clean(parsed.seoTitle || title).slice(0, 60),\n  seoDescription: clean(parsed.seoDescription || excerpt).slice(0, 160),\n  date: $now.toFormat('yyyy-MM-dd'),\n  research: research.message || '',\n} }];"
      }
    },
