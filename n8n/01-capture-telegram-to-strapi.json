      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst doc = d.data || {};\nconst id = doc.documentId || doc.id;\nconst err = d.error?.message || d.error || d.message || '';\nconst base = String($env.STRAPI_URL || '').replace(/\\/$/, '');\nreturn [{ json: {\n  platform: 'strapi',\n  status: id ? (doc.createdAt === doc.updatedAt ? 'drafted' : 'updated') : 'failed',\n  url: id && base ? base + '/admin/content-manager/collection-types/api::article.article/' + id : '',\n  error: id ? '' : String(err || 'Strapi returned no documentId'),\n  documentId: id || '',\n} }];"
      }
    },
