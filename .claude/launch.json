{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gatsby-develop",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "gatsby-serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "gatsby",
        "serve",
        "-p",
        "9111"
      ],
      "port": 9111
    }
  ]
}